    {"action": "shell", "resource": "git reset --hard *", "effect": "ask"},
    {"action": "shell", "resource": "git branch -D *", "effect": "ask"},
    {"action": "shell", "resource": "git branch -d *--force*", "effect": "ask"},
    {"action": "shell", "resource": "git worktree remove *--force*", "effect": "ask"},
    {"action": "shell", "resource": "git worktree prune*", "effect": "ask"},
    {"action": "shell", "resource": "git rebase *", "effect": "ask"},
    {"action": "shell", "resource": "git stash drop*", "effect": "ask"},
    {"action": "shell", "resource": "git stash clear*", "effect": "ask"},
    {"action": "shell", "resource": "git reflog expire*", "effect": "ask"},
    {"action": "shell", "resource": "git gc *--prune*", "effect": "ask"},
    {"action": "shell", "resource": "git clean -f*", "effect": "ask"},
    {"action": "shell", "resource": "git checkout -- *", "effect": "ask"},
    {"action": "shell", "resource": "docker push *", "effect": "ask"},
    {"action": "shell", "resource": "docker * prune*", "effect": "ask"},
    {"action": "shell", "resource": "npm publish*", "effect": "ask"},
    {"action": "shell", "resource": "cargo publish*", "effect": "ask"},
    {"action": "shell", "resource": "twine upload*", "effect": "ask"},
    {"action": "shell", "resource": "terraform apply*", "effect": "ask"},
    {"action": "shell", "resource": "terraform destroy*", "effect": "ask"},
    {"action": "shell", "resource": "kubectl apply*", "effect": "ask"},
    {"action": "shell", "resource": "kubectl delete*", "effect": "ask"},
    {"action": "shell", "resource": "curl *-d *", "effect": "ask"},
    {"action": "shell", "resource": "curl *--data*", "effect": "ask"},
    {"action": "shell", "resource": "curl *-F *", "effect": "ask"},
    {"action": "shell", "resource": "curl *-T *", "effect": "ask"},
    {"action": "shell", "resource": "scp *", "effect": "ask"},
    {"action": "shell", "resource": "* | sh*", "effect": "ask"},
    {"action": "shell", "resource": "* | bash*", "effect": "ask"}
  ],
  // ======================================================================
  // Policies: hard denies that an approval prompt cannot override (shell only)
  "policies": [
    {"action": "tool.use", "resource": "shell:* | sh*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:* | bash*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:* | sudo *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*opencode.db*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*auth.json*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:rm -rf /", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:rm -rf ~", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:rm -rf $HOME", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:git push *--force*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:git push -f*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:git push * -f*", "effect": "deny"},
    // catastrophic commands — hard deny, an approval prompt cannot override these;
    // the guardrails plugin adds a regex layer for patterns globs express badly.
    // If you ever really need one, run it manually in your own terminal.
    {"action": "tool.use", "resource": "shell:rm -rf / *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:rm -rf /*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:rm -rf ~ *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:rm -rf ~/*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:rm -rf $HOME *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:rm -rf $HOME/*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:rm -rf .", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:rm -rf ./", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:rm -rf . *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:rm -rf --no-preserve-root *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:rm -r /", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:rm -fr / *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:dd *of=/dev/*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:mkfs*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:wipefs *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:blkdiscard *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:chmod -R 777 / *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:shutdown *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:reboot *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:poweroff *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:halt *", "effect": "deny"}
  ]
}
