{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  // Project docs auto-loaded every session (silently skipped if the file does not exist):
  // PLAN.md = goal / steps / who is working on what / next; CONTEXT.md = what the project is, decisions, gotchas.
  "instructions": ["PLAN.md", "CONTEXT.md"],
  // Default model = GLM 5.3 Flash on NVIDIA NIM (chat, routing, light work).
  // builder, architect, reviewer and sec are pinned to nvidia/nemotron-ultra (256K ctx) in agents/*.md.
  // `private` and `medical` run on opencode/deepseek-v4.1-flash-free (zero-retention, see README).
  "model": "nvidia/glm-5-3-flash",
  // v2 native replacement for v1 "small_model": the built-in `title` agent
  // generates session titles, so point it at the fastest keyless zero-retention
  // free model (measured 3 s first byte 2026-11-17) instead of the NIM queue.
  "agents": {
    "title": {
      "model": "nvidia/glm-5-3-flash"
    }
  },
  "share": "disabled",
  "update": "notify",
  "snapshots": true,
  "timezone": "Asia/Kolkata",
  "formatter": true,
  "lsp": true,
  // Cap tool output so huge shell/read results cannot blow the context window
  // (Codex budgets shell output at ~10k tokens; v2 equivalent is lines+bytes)
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "websearch": {
    "provider": "random"
  },
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/target/**",
      "**/.venv/**",
      "**/dist/**",
      "**/build/**",
      "**/__pycache__/**",
      "**/.scratch/**",
      "**/.git/**"
    ]
  },
  // ======================================================================
  // Provider: NVIDIA NIM free endpoints. modelID = the API id (see /v1/models); the key is only OpenCode's alias. Key comes from /connect or $NVIDIA_API_KEY.
  "providers": {
    "nvidia": {
      "name": "NVIDIA NIM (free endpoints)",
      "env": [
        "NVIDIA_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "compatibility": {
        "requireFinishReason": false
      },
      "settings": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "headerTimeout": 600000,
        "chunkTimeout": 900000,
        "timeout": 1800000
      },
      "models": {
        "glm-5-3-flash": {
          "name": "GLM-5.3 Flash",
          "modelID": "z-ai/glm-5.3-flash",
          "limit": {
            "context": 200000,
            "output": 32768
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": false
            }
          }
        },
        // OPT-IN, not assigned to any agent. The model card lists reasoning and image input but does not state
        // tool calling, so run the smoke test in TESTING.md before pointing an agent at it (README: "Swapping models").
        "deepseek-v4-1-flash": {
          "name": "DeepSeek V4.1 Flash (NIM)",
          "modelID": "deepseek-ai/deepseek-v4.1-flash",
          // Conflicting evidence: our own live error showed EOL on NIM 2026-11-16, a probe on 2026-11-19 lists it free.
          // Fallback only. scripts/models.sh check tells you if it works on your key.
          "limit": {"context": 1000000, "output": 65536},
          "capabilities": {"tools": true, "input": ["text"], "output": ["text"]}
        },
        "minimax-m3-1-flash": {
          "name": "MiniMax M3.1 Flash",
          "modelID": "minimaxai/minimax-m3.1-flash",
          "limit": {
            "context": 200000,
            "output": 32768
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": {
              "supported": true
            }
          }
        },
        "nemotron-ultra": {
          "name": "Nemotron 3 Ultra 550B",
          "modelID": "nvidia/nemotron-3-ultra-550b-a55b",
          "limit": {
            // native ctx on the hosted NIM endpoint (docs.nvidia.com/nim 2.0.7, 2026-06-26); 1M only self-hosted
            "context": 262144,
            "output": 32768
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": false
            }
          }
        }
      }
    },
    // Second provider for failover (free key, no card): GROQ_API_KEY. Used only if you run
    // `scripts/models.sh fallback`; nothing points at it by default.
    "groq": {
      "name": "Groq (free plan)",
      "env": ["GROQ_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {"baseURL": "https://api.groq.com/openai/v1"},
      "models": {
        "gpt-oss-120b": {
          "name": "GPT-OSS 120B (Groq free)",
          "modelID": "openai/gpt-oss-120b",
          "limit": {"context": 131072, "output": 65536},
          "capabilities": {"tools": true, "input": ["text"], "output": ["text"]}
        }
      }
    },
    // ======================================================================
    // OpenRouter `:free` models (free account key: OPENROUTER_API_KEY, no card).
    // Limits: 20 RPM, 50 requests/day (1,000/day only after buying $10 of credits —
    // openrouter.ai/docs/api_reference/limits, 2026-11-17). Small daily cap, but
    // Nemotron 3 Ultra :free has a 1M context — ideal for occasional big-context
    // verification/research passes, not for hot loops. Provider capacity can 429.
    "openrouter": {
      "name": "OpenRouter :free models",
      "env": [
        "OPENROUTER_API_KEY"
      ],
      "models": {
        "free-router": {
          "name": "openrouter/free router (auto-selects a free model)",
          "modelID": "openrouter/free",
          "limit": {
            "context": 200000,
            "output": 16384
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  // ======================================================================
  // MCP servers (direct tools, not Code Mode): context7 + deepwiki (docs), thinking (structured reasoning), memory (orchestrator only, no personal/medical data), playwright + devtools (tester only), github (off until signed in)
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "codemode": false,
        "timeout": {
          "startup": 60000,
          "catalog": 90000,
          "execution": 120000
        }
      },
      "deepwiki": {
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp",
        "oauth": false,
        "codemode": false,
        "timeout": {
          "startup": 60000,
          "catalog": 90000,
          "execution": 180000
        }
      },
      "thinking": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-sequential-thinking@2.1.1"
        ],
        "codemode": false,
        "timeout": {
          "startup": 90000,
          "catalog": 30000,
          "execution": 60000
        }
      },
      "memory": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-memory@2.1.1"
        ],
        "environment": {
          "MEMORY_FILE_PATH": "{env:HOME}/.config/opencode/memory.json"
        },
        "codemode": false,
        "timeout": {
          "startup": 90000,
          "catalog": 30000,
          "execution": 60000
        }
      },
      // ---- visuals / design MCPs (keyless, npx) ----
      // mermaid: fully LOCAL renderer (no browser) — safe for confidential diagram sources
      // (zombie-mermaid CLI exposes `mcp` subcommand; tools: render_mermaid_svg/ascii, verified 2026-11-17)
      "mermaid": {
        "type": "local",
        "command": ["npx", "-y", "zombie-mermaid", "mcp"],
        "codemode": false,
        "timeout": { "startup": 120000, "catalog": 30000, "execution": 120000 }
      },
      // excalidraw: local .excalidraw file CRUD + SVG/PNG export — fully local, confidential OK
      "excalidraw": {
        "type": "local",
        "command": ["npx", "-y", "excalidraw-mcp"],
        "codemode": false,
        "timeout": { "startup": 120000, "catalog": 30000, "execution": 120000 }
      },
      // ---- security / RE MCPs (keyless) ----
      // CVE/advisory lookup is NOT an MCP on this box (npm NVD/OSV servers need Node >=24;
      // pypi nvd-cve-mcp-server breaks on Python 3.14) — use the CLI helpers instead:
      //   ~/.local/bin/cve CVE-2021-44228 | cve -k keyword | cve --cpe ...   (NVD API, keyless 5/30s, KEV flag)
      //   ~/.local/bin/osvq --pkg requests --eco PyPI --ver 2.31.0           (OSV.dev, keyless)
      //   ~/.local/bin/osv-scanner ...                                        (offline dep scans)
      // mitre: ATT&CK STIX (verified 2026-11-17: 26 tools via `npx -y mitre-mcp`)
      "mitre": {
        "type": "local",
        "command": ["npx", "-y", "mitre-mcp"],
        "codemode": false,
        "timeout": { "startup": 240000, "catalog": 60000, "execution": 120000 }
      },
      // ---- Canva remote MCP: per-user OAuth, no API key ----
      // https://mcp.canva.com/mcp — first use triggers browser consent; complete it with
      // `opencode mcp auth canva`. Canva tools can MODIFY real designs -> allowed only for
      // orchestrator + designer (global deny below; per-agent allows in agents/*.md).
      // OFF by default: needs a Canva account and can change real designs. Set "enabled": true to use it.
      "canva": {
        "enabled": false,
        "type": "remote",
        "url": "https://mcp.canva.com/mcp",
        "oauth": false,
        "codemode": false,
        "timeout": {
          "startup": 60000,
          "catalog": 90000,
          "execution": 180000
        }
      },
      // Keyless web search/fetch as a second route when the built-in websearch is unavailable (anonymous rate limits).
      "parallel": {
        "type": "remote",
        "url": "https://mcp.parallel.ai/mcp",
        "codemode": false,
        "timeout": {"startup": 60000, "catalog": 60000, "execution": 120000}
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@0.0.85",
          "--headless",
          "--isolated",
          "--browser",
          "chromium"
        ],
        "codemode": false,
        "timeout": {
          "startup": 180000,
          "catalog": 60000,
          "execution": 300000
        }
      },
      // chrome-devtools-mcp: Chrome DevTools protocol MCP (33 tools verified 2026-11-17).
      // No Chrome in PATH on this box -> point at the system Chromium binary and pass
      // --no-sandbox via --chrome-arg (we run as root; Chromium refuses to start sandboxed).
      "devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@1.13.0",
          "--headless",
          "--isolated",
          "--no-usage-statistics",
          "--no-performance-crux",
          "--executablePath",
          "/usr/lib64/chromium-browser/chromium-browser",
          "--chrome-arg=--no-sandbox",
          "--chrome-arg=--disable-setuid-sandbox"
        ],
        "codemode": false,
        "timeout": {
          "startup": 180000,
          "catalog": 60000,
          "execution": 300000
        }
      }
    }
  },
  // ======================================================================
  // Parallel agents: git worktrees live here (inside the project, git-ignored via .scratch)
  "worktree": {
    "directory": ".scratch/wt"
  },
  // ======================================================================
  // Long-running work: todo list, background compaction, large keep window
  "experimental": {
    "todo": true,
    "subagent_depth": 1,
    "background_compaction": true,
    // default model for the experimental_image_generate tool: OpenRouter :free image model
    // (needs OPENROUTER_API_KEY). Free-tier hosts may train on prompts -> PUBLIC prompts only.
    "image_generate": {
      "model": "openrouter/recraft/recraft-v4.1-flash-v2:free"
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 64000
    },
    "buffer": "20%"
  },
  // ======================================================================
  // Permissions (ordered, LAST match wins): broad allows first, then credential denies, then asks
  "permissions": [
    {"action": "read", "resource": "*", "effect": "allow"},
    {"action": "glob", "resource": "*", "effect": "allow"},
    {"action": "grep", "resource": "*", "effect": "allow"},
    {"action": "edit", "resource": "*", "effect": "allow"},
    {"action": "shell", "resource": "*", "effect": "allow"},
    {"action": "webfetch", "resource": "*", "effect": "deny"},
    {"action": "websearch", "resource": "*", "effect": "deny"},
    {"action": "skill", "resource": "*", "effect": "allow"},
    {"action": "question", "resource": "*", "effect": "allow"},
    {"action": "subagent", "resource": "*", "effect": "deny"},
    {"action": "playwright_*", "resource": "*", "effect": "deny"},
    {"action": "context7_*", "resource": "*", "effect": "deny"},
    {"action": "deepwiki_*", "resource": "*", "effect": "deny"},
    // visuals + security MCPs: denied globally, re-allowed per agent (orchestrator/designer/sec/researcher)
    {"action": "mermaid_*", "resource": "*", "effect": "deny"},
    {"action": "excalidraw_*", "resource": "*", "effect": "deny"},
    // (nvd_*/osv_* MCP entries removed 2026-11-17 — those servers need Node>=24; CVE/OSV lookup is via ~/.local/bin/cve and ~/.local/bin/osvq shell helpers now)
    {"action": "mitre_*", "resource": "*", "effect": "deny"},
    {"action": "parallel_*", "resource": "*", "effect": "deny"},
    {"action": "experimental_image_generate", "resource": "*", "effect": "deny"},
    {"action": "memory_*", "resource": "*", "effect": "deny"},
    {"action": "thinking_*", "resource": "*", "effect": "deny"},
    {"action": "devtools_*", "resource": "*", "effect": "deny"},
    {"action": "canva_*", "resource": "*", "effect": "deny"},
    {"action": "external_directory", "resource": "*", "effect": "ask"},
    {"action": "read", "resource": "*/.ssh/*", "effect": "deny"},
    {"action": "edit", "resource": "*/.ssh/*", "effect": "deny"},
    {"action": "grep", "resource": "*/.ssh/*", "effect": "deny"},
    {"action": "glob", "resource": "*/.ssh/*", "effect": "deny"},
    {"action": "shell", "resource": "*/.ssh/*", "effect": "deny"},
    {"action": "read", "resource": "*/.aws/*", "effect": "deny"},
    {"action": "edit", "resource": "*/.aws/*", "effect": "deny"},
    {"action": "grep", "resource": "*/.aws/*", "effect": "deny"},
    {"action": "glob", "resource": "*/.aws/*", "effect": "deny"},
    {"action": "shell", "resource": "*/.aws/*", "effect": "deny"},
    {"action": "read", "resource": "*/.gnupg/*", "effect": "deny"},
    {"action": "edit", "resource": "*/.gnupg/*", "effect": "deny"},
    {"action": "grep", "resource": "*/.gnupg/*", "effect": "deny"},
    {"action": "glob", "resource": "*/.gnupg/*", "effect": "deny"},
    {"action": "shell", "resource": "*/.gnupg/*", "effect": "deny"},
    {"action": "read", "resource": "*/.kube/*", "effect": "deny"},
    {"action": "edit", "resource": "*/.kube/*", "effect": "deny"},
    {"action": "grep", "resource": "*/.kube/*", "effect": "deny"},
    {"action": "glob", "resource": "*/.kube/*", "effect": "deny"},
    {"action": "shell", "resource": "*/.kube/*", "effect": "deny"},
    {"action": "read", "resource": "*/.config/gh/*", "effect": "deny"},
    {"action": "edit", "resource": "*/.config/gh/*", "effect": "deny"},
    {"action": "grep", "resource": "*/.config/gh/*", "effect": "deny"},
    {"action": "glob", "resource": "*/.config/gh/*", "effect": "deny"},
    {"action": "shell", "resource": "*/.config/gh/*", "effect": "deny"},
    {"action": "read", "resource": "*/.docker/config.json", "effect": "deny"},
    {"action": "edit", "resource": "*/.docker/config.json", "effect": "deny"},
    {"action": "grep", "resource": "*/.docker/config.json", "effect": "deny"},
    {"action": "glob", "resource": "*/.docker/config.json", "effect": "deny"},
    {"action": "shell", "resource": "*/.docker/config.json*", "effect": "deny"},
    {"action": "read", "resource": "*/.gcp/*", "effect": "deny"},
    {"action": "edit", "resource": "*/.gcp/*", "effect": "deny"},
    {"action": "grep", "resource": "*/.gcp/*", "effect": "deny"},
    {"action": "glob", "resource": "*/.gcp/*", "effect": "deny"},
    {"action": "shell", "resource": "*/.gcp/*", "effect": "deny"},
    {"action": "read", "resource": "*/.azure/*", "effect": "deny"},
    {"action": "edit", "resource": "*/.azure/*", "effect": "deny"},
    {"action": "grep", "resource": "*/.azure/*", "effect": "deny"},
    {"action": "glob", "resource": "*/.azure/*", "effect": "deny"},
    {"action": "shell", "resource": "*/.azure/*", "effect": "deny"},
    {"action": "read", "resource": "*/.config/gcloud/*", "effect": "deny"},
    {"action": "edit", "resource": "*/.config/gcloud/*", "effect": "deny"},
    {"action": "grep", "resource": "*/.config/gcloud/*", "effect": "deny"},
    {"action": "glob", "resource": "*/.config/gcloud/*", "effect": "deny"},
    {"action": "shell", "resource": "*/.config/gcloud/*", "effect": "deny"},
    {"action": "read", "resource": "*/.pypirc", "effect": "deny"},
    {"action": "edit", "resource": "*/.pypirc", "effect": "deny"},
    {"action": "grep", "resource": "*/.pypirc", "effect": "deny"},
    {"action": "glob", "resource": "*/.pypirc", "effect": "deny"},
    {"action": "shell", "resource": "*/.pypirc*", "effect": "deny"},
    {"action": "read", "resource": "*/.netrc", "effect": "deny"},
    {"action": "edit", "resource": "*/.netrc", "effect": "deny"},
    {"action": "grep", "resource": "*/.netrc", "effect": "deny"},
    {"action": "glob", "resource": "*/.netrc", "effect": "deny"},
    {"action": "shell", "resource": "*/.netrc*", "effect": "deny"},
    {"action": "read", "resource": "*/.git-credentials", "effect": "deny"},
    {"action": "edit", "resource": "*/.git-credentials", "effect": "deny"},
    {"action": "grep", "resource": "*/.git-credentials", "effect": "deny"},
    {"action": "glob", "resource": "*/.git-credentials", "effect": "deny"},
    {"action": "shell", "resource": "*/.git-credentials*", "effect": "deny"},
    {"action": "read", "resource": "*/.local/share/opencode/auth.json", "effect": "deny"},
    {"action": "edit", "resource": "*/.local/share/opencode/auth.json", "effect": "deny"},
    {"action": "grep", "resource": "*/.local/share/opencode/auth.json", "effect": "deny"},
    {"action": "glob", "resource": "*/.local/share/opencode/auth.json", "effect": "deny"},
    {"action": "shell", "resource": "*/.local/share/opencode/auth.json*", "effect": "deny"},
    {"action": "read", "resource": "*/.local/share/opencode/opencode.db*", "effect": "deny"},
    {"action": "edit", "resource": "*/.local/share/opencode/opencode.db*", "effect": "deny"},
    {"action": "grep", "resource": "*/.local/share/opencode/opencode.db*", "effect": "deny"},
    {"action": "glob", "resource": "*/.local/share/opencode/opencode.db*", "effect": "deny"},
    {"action": "shell", "resource": "*/.local/share/opencode/opencode.db*", "effect": "deny"},
    {"action": "shell", "resource": "*auth.json*", "effect": "deny"},
    {"action": "shell", "resource": "*opencode.db*", "effect": "deny"},
    {"action": "read", "resource": "*.env", "effect": "deny"},
    {"action": "edit", "resource": "*.env", "effect": "deny"},
    {"action": "grep", "resource": "*.env*", "effect": "deny"},
    {"action": "glob", "resource": "*.env*", "effect": "deny"},
    {"action": "shell", "resource": "*/.env*", "effect": "deny"},
    {"action": "read", "resource": "*/.env", "effect": "deny"},
    {"action": "edit", "resource": "*/.env", "effect": "deny"},
    {"action": "read", "resource": "*.env.example", "effect": "allow"},
    {"action": "read", "resource": "*.env.sample", "effect": "allow"},
    {"action": "read", "resource": "*confidential*", "effect": "ask"},
    {"action": "edit", "resource": "*confidential*", "effect": "ask"},
    {"action": "grep", "resource": "*confidential*", "effect": "ask"},
    {"action": "glob", "resource": "*confidential*", "effect": "ask"},
    {"action": "shell", "resource": "*confidential*", "effect": "ask"},
    {"action": "read", "resource": "*.pem", "effect": "ask"},
    {"action": "edit", "resource": "*.pem", "effect": "deny"},
    {"action": "grep", "resource": "*.pem", "effect": "deny"},
    {"action": "shell", "resource": "*.pem*", "effect": "deny"},
    {"action": "read", "resource": "*.key", "effect": "ask"},
    {"action": "edit", "resource": "*.key", "effect": "deny"},
    {"action": "grep", "resource": "*.key", "effect": "deny"},
    {"action": "shell", "resource": "*.key*", "effect": "deny"},
    {"action": "read", "resource": "*id_rsa*", "effect": "deny"},
    {"action": "shell", "resource": "*id_rsa*", "effect": "deny"},
    {"action": "read", "resource": "*credentials*", "effect": "deny"},
    {"action": "grep", "resource": "*credentials*", "effect": "deny"},
    {"action": "shell", "resource": "*credentials*", "effect": "deny"},
    {"action": "read", "resource": "*secret*", "effect": "deny"},
    {"action": "grep", "resource": "*secret*", "effect": "deny"},
    {"action": "shell", "resource": "*secret*", "effect": "deny"},
    {"action": "read", "resource": "*/.npmrc", "effect": "deny"},
    {"action": "shell", "resource": "*/.npmrc*", "effect": "deny"},
    {"action": "edit", "resource": "*/.config/opencode/*", "effect": "ask"},
    {"action": "shell", "resource": "rm *", "effect": "ask"},
    {"action": "shell", "resource": "sh *", "effect": "ask"},
    {"action": "shell", "resource": "bash *", "effect": "ask"},
    {"action": "shell", "resource": "zsh *", "effect": "ask"},
    {"action": "shell", "resource": "eval *", "effect": "ask"},
    {"action": "shell", "resource": "exec *", "effect": "ask"},
    {"action": "shell", "resource": "wget *", "effect": "ask"},
    {"action": "shell", "resource": "curl *", "effect": "ask"},
    {"action": "shell", "resource": "nc *", "effect": "ask"},
    {"action": "shell", "resource": "ncat *", "effect": "ask"},
    {"action": "shell", "resource": "ssh *", "effect": "ask"},
    {"action": "shell", "resource": "scp *", "effect": "ask"},
    {"action": "shell", "resource": "rsync *", "effect": "ask"},
    {"action": "shell", "resource": "python3 -c *", "effect": "ask"},
    {"action": "shell", "resource": "python -c *", "effect": "ask"},
    {"action": "shell", "resource": "node -e *", "effect": "ask"},
    {"action": "shell", "resource": "perl -e *", "effect": "ask"},
    {"action": "shell", "resource": "ruby -e *", "effect": "ask"},
    {"action": "shell", "resource": "base64 *", "effect": "ask"},
    {"action": "shell", "resource": "*|sh*", "effect": "ask"},
    {"action": "shell", "resource": "*|bash*", "effect": "ask"},
    {"action": "shell", "resource": "sudo *", "effect": "ask"},
    {"action": "shell", "resource": "dnf *", "effect": "ask"},
    {"action": "shell", "resource": "dd *", "effect": "ask"},
    {"action": "shell", "resource": "mkfs*", "effect": "ask"},
    {"action": "shell", "resource": "shutdown*", "effect": "ask"},
    {"action": "shell", "resource": "reboot*", "effect": "ask"},
